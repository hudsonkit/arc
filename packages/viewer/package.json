{
  "name": "@hudsonkit/arc-viewer",
  "version": "0.13.3",
  "description": "Native React renderers for diagrams as code, including interactive Mermaid sequences",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "react",
    "react-component",
    "diagram",
    "diagrams-as-code",
    "architecture",
    "viewer",
    "player",
    "svg",
    "declarative",
    "mermaid",
    "sequence-diagram",
    "sequence",
    "flowchart",
    "state-diagram"
  ],
  "author": "Arach Tchoupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudsonkit/arc.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://arc.jdi.sh"
}
