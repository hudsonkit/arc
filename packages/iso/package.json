{
  "name": "@hudsonkit/arc-iso",
  "version": "0.14.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Isometric diagrams as code for React and the browser",
  "author": "Arach Tchoupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudsonkit/arc.git",
    "directory": "packages/iso"
  },
  "keywords": [
    "diagram",
    "isometric",
    "isometric-diagram",
    "embed",
    "visualization",
    "react",
    "react-component",
    "svg",
    "diagrams-as-code",
    "architecture-diagram",
    "3d",
    "vanilla-js",
    "standalone"
  ],
  "homepage": "https://arc.jdi.sh",
  "files": [
    "dist"
  ],
  "main": "./dist/arc-iso.cjs",
  "module": "./dist/arc-iso.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/arc-iso.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/arc-iso.cjs"
      }
    },
    "./slim": {
      "import": {
        "types": "./dist/index.slim.d.ts",
        "default": "./dist/arc-iso-slim.es.js"
      },
      "require": {
        "types": "./dist/index.slim.d.cts",
        "default": "./dist/arc-iso-slim.cjs"
      }
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "slim": [
        "./dist/index.slim.d.ts"
      ]
    }
  }
}
