{
  "name": "@arach/arc-iso",
  "version": "0.13.1",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Isometric diagrams as code for React and the browser",
  "author": "Arach Tchoupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudsonkit/arc.git",
    "directory": "packages/iso"
  },
  "keywords": [
    "diagram",
    "isometric",
    "isometric-diagram",
    "embed",
    "visualization",
    "react",
    "react-component",
    "svg",
    "diagrams-as-code",
    "architecture-diagram",
    "3d",
    "vanilla-js",
    "standalone"
  ],
  "homepage": "https://arc.jdi.sh",
  "files": [
    "dist"
  ],
  "main": "./dist/arc-iso.umd.js",
  "module": "./dist/arc-iso.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arc-iso.es.js",
      "require": "./dist/arc-iso.umd.js"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/arc-iso-slim.es.js",
      "require": "./dist/arc-iso-slim.umd.js"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
