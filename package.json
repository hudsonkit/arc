{
  "name": "@arach/arc",
  "version": "0.13.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "description": "A visual explanation toolkit for software systems — interactive diagrams, guided stories, animated flows, visual editing, and CLI + MCP tools",
  "author": "Arach Tchoupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudsonkit/arc.git"
  },
  "homepage": "https://hudsonkit.com/arc",
  "bugs": {
    "url": "https://github.com/hudsonkit/arc/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "diagram",
    "diagrams",
    "editor",
    "architecture",
    "architecture-diagram",
    "diagram-as-code",
    "diagrams-as-code",
    "visualization",
    "react",
    "react-component",
    "react-diagram",
    "diagram-editor",
    "isometric",
    "ascii",
    "ascii-diagram",
    "ascii-art",
    "svg",
    "png",
    "gif",
    "mp4",
    "mermaid",
    "sequence-diagram",
    "flowchart",
    "system-design",
    "infrastructure",
    "cloud-architecture",
    "cli",
    "typescript",
    "mcp",
    "model-context-protocol",
    "json-schema"
  ],
  "bin": {
    "arc": "./bin/arc.mjs",
    "arc-ascii": "./bin/arc-ascii.mjs"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.css",
    "bin/arc.mjs",
    "bin/arc-ascii.mjs",
    "docs/llm.txt",
    "schemas/arc-diagram.schema.json",
    "skills/arc-diagrams/SKILL.md",
    "src/types/diagram.ts"
  ],
  "main": "./lib/arc.umd.js",
  "module": "./lib/arc.es.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/arc.es.js",
      "require": "./lib/arc.umd.js"
    },
    "./arc.css": "./lib/arc.css",
    "./style.css": "./lib/arc.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-docs-html.js",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:mcp": "bun packages/mcp/build.mjs",
    "build:cli": "bun scripts/build-arc-cli.mjs",
    "mcp": "bun packages/mcp/src/server.ts",
    "mcp:http": "bun packages/mcp/src/http-server.ts",
    "build:iso": "vite build --config vite.config.iso.js && vite build --config vite.config.iso-slim.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "visual": "bun scripts/visualCheck.ts",
    "visual:update": "bun scripts/visualCheck.ts --update",
    "generate:schema": "bun scripts/generate-schema.ts",
    "generate-og": "node scripts/generate-og.js",
    "check:dist": "attw --pack . --ignore-rules cjs-resolves-to-esm unexpected-module-syntax --exclude-entrypoints ./arc.css ./style.css && publint && node scripts/check-packlist.mjs",
    "prepublishOnly": "bun run build:lib && bun run build:cli && bun run check:dist",
    "build:site": "bun run build:lib && bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arach/dewey": "^0.2.0",
    "@arethetypeswrong/cli": "^0.18.4",
    "@base-ui/react": "^1.0.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hudsonkit": "^0.3.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.562.0",
    "publint": "^0.3.21",
    "puppeteer": "^24.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
